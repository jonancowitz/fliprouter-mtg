# PostgreSQL connection string (Supabase / Railway / local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fliprouter_mtg"

# Set to "false" when connecting through PgBouncer / Supabase transaction pooler
DATABASE_PREPARE="false"

# Required User-Agent header for Scryfall Bulk Data API requests
SCRYFALL_USER_AGENT="FlipRouterMTG/0.1 (+https://github.com/jonancowitz/fliprouter-mtg)"
